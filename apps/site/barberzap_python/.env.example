# BarberZap - Environment Variables Example
# Copy this file to .env and fill in your actual credentials

# ====================
# SUPABASE CREDENTIALS
# ====================
SUPABASE_URL=https://htssqiupscyhhueqwpgu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:[password]@db.htssqiupscyhhueqwpgu.supabase.co:5432/postgres

# ====================
# EVOLUTION API (WhatsApp)
# ====================
EVOLUTION_API_URL=https://your-evolution-api-instance.com
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_API_INSTANCE=barberzap_instance

# ====================
# AI CONFIGURATION
# ====================
AI_API_KEY=your_openrouter_api_key_or_other
AI_MODEL=openai/gpt-4o-mini
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ====================
# APPLICATION SETTINGS
# ====================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=BarberZap

# ====================
# LOGGING
# ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====================
# WEBHOOK CONFIG
# ====================
WEBHOOK_SECRET=your_webhook_secret_for_validation
WEBHOOK_TIMEOUT=30

# ====================
# TENANT DEFAULTS
# ====================
DEFAULT_LANGUAGE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
