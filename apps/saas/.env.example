# Configuracao publica do frontend SaaS. Nao use secrets com prefixo VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade temporaria: prefira VITE_SUPABASE_PUBLISHABLE_KEY em codigo novo.
VITE_SUPABASE_ANON_KEY=

# Opcional: não configurar enquanto não houver um backend HTTP público para o SaaS.
VITE_API_BASE_URL=
