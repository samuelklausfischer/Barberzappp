# BarberZap Redis Cache - Environment Variables

# ==========================================
# REDIS CONNECTION
# ==========================================

# Redis URL (format: redis://user:pass@host:port/db)
REDIS_URL=redis://localhost:6379/0

# Individual Redis connection parameters (used if REDIS_URL not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SSL/TLS Configuration
REDIS_SSL=false
REDIS_SSL_CERT_REQS=required

# ==========================================
# CONNECTION POOL
# ==========================================

REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# ==========================================
# TTL CONFIGURATION (Time To Live in seconds)
# ==========================================

# Tenant data - stays cached longer as it changes infrequently
CACHE_TTL_TENANT=3600          # 1 hour

# Services list - updates occasionally
CACHE_TTL_SERVICES=1800        # 30 minutes

# Appointments - need to be fresh for real-time availability
CACHE_TTL_APPOINTMENTS=300     # 5 minutes

# Client data - updates occasionally
CACHE_TTL_CLIENT=1800          # 30 minutes

# Client statistics - can be somewhat stale
CACHE_TTL_CLIENT_STATS=900     # 15 minutes

# Session data
CACHE_TTL_SESSION=7200         # 2 hours

# ==========================================
# RETRY POLICY
# ==========================================

REDIS_MAX_RETRIES=3
REDIS_RETRY_BASE_DELAY=0.5     # seconds
REDIS_RETRY_MAX_DELAY=2.0      # seconds
REDIS_RETRY_EXP_BASE=2

# ==========================================
# METRICS & MONITORING
# ==========================================

# Enable/disable cache metrics collection
CACHE_METRICS_ENABLED=true

# Sample rate for metrics (0.0 to 1.0)
CACHE_METRICS_SAMPLE_RATE=1.0

# ==========================================
# PUB/SUB DISTRIBUTED INVALIDATION
# ==========================================

# Channel for cache invalidation messages
CACHE_INVALIDATION_CHANNEL=barberzap:invalidate

# Enable/disable distributed cache invalidation
CACHE_PUBSUB_ENABLED=true

# ==========================================
# SUPABASE WEBHOOK (for cache invalidation)
# ==========================================

# Webhook secret for validating Supabase webhook requests
# SUPABASE_WEBHOOK_SECRET=your_secret_here

# Webhook endpoint path
SUPABASE_WEBHOOK_PATH=/webhooks/supabase-cache

# ==========================================
# LOGGING
# ==========================================

# Log level for cache operations (DEBUG, INFO, WARNING, ERROR)
CACHE_LOG_LEVEL=INFO

# ==========================================
# DEVELOPMENT / PRODUCTION
# ==========================================

# Environment (development, staging, production)
ENV=development

# Debug mode
DEBUG=false
