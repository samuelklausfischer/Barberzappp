# ============================================================================
# BULLMQ ENVIRONMENT VARIABLES
# BarberZap Background Jobs System
# ============================================================================

# Copie este arquivo para .env e preencha com suas variáveis reais

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# URL de conexão do Redis
# Exemplos:
# - Local: redis://localhost:6379
# - Com senha: redis://:password@localhost:6379
# - Redis Cloud: redis://username:password@host:port
# - Upstash: rediss://default:password@host:port
REDIS_URL=redis://localhost:6379

# ============================================================================
# WHATSAPP API CONFIGURATION
# ============================================================================
# Meta Business API / Twilio / Outra API de WhatsApp

# API Key da plataforma de WhatsApp
WHATSAPP_API_KEY=your-api-key-here

# Phone Number ID (Meta Business API)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here

# Base URL da API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Opcional: Sender ID para Twilio
# TWILIO_SENDER_ID=your-sender-id

# ============================================================================
# SUPABASE CONFIGURATION (para CRM e logs)
# ============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# WORKER CONFIGURATION
# ============================================================================
# Número de workers simultâneos por fila
WORKER_CONCURRENCY_NOTIFICATIONS=5
WORKER_CONCURRENCY_CRM=3
WORKER_CONCURRENCY_WHATSAPP=3

# ============================================================================
# ENABLE/DISABLE FEATURES
# ============================================================================
# Habilitar lembretes automáticos
ENABLE_AUTO_REMINDERS=true

# Habilitar logging detalhado
ENABLE_VERBOSE_LOGGING=false

# ============================================================================
# MONITORING & ALERTS
# ============================================================================
# Limite de jobs falhos antes de enviar alerta
FAILED_JOBS_ALERT_THRESHOLD=10

# Email para alertas (opcional)
# ALERT_EMAIL=admin@barberzap.com

# ============================================================================
# ADVANCED CONFIGURATION
# ============================================================================
# Job TTL (time to live) em milissegundos
JOB_TTL_COMPLETED=86400000  # 24 horas
JOB_TTL_FAILED=604800000     # 7 dias

# Delay entre retries (base para exponential backoff)
RETRY_BASE_DELAY=2000

# ============================================================================
# NOTES
# ============================================================================
# 1. Para produção, use sempre Redis com senha
# 2. Configure rate limits na API de WhatsApp
# 3. Monitore as filas regularmente usando: npm run stats
# 4. Use Dead Letter Queue para debug de jobs falhos
# 5. Configure alertas para jobs com alta taxa de falha
