{
  "name": "barberzap-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "node scripts/validate-vercel-env.mjs && npm run typecheck:app && npm run build",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "test:agenda": "node --test --test-isolation=none --experimental-strip-types tests/unit/agendaDateRange.test.ts tests/unit/agendaTimeline.test.ts",
    "preview": "vite preview",
    "test:load:setup": "k6 run tests/load/setup.js",
    "test:load:cleanup": "k6 run --env DRY_RUN=false tests/load/cleanup.js",
    "test:load:cleanup:dry": "k6 run --env DRY_RUN=true tests/load/cleanup.js",
    "test:load:booking:baseline": "k6 run --env SCENARIO=baseline tests/load/load-booking.test.js",
    "test:load:booking:10": "k6 run --env SCENARIO=concurrent_10 tests/load/load-booking.test.js",
    "test:load:booking:50": "k6 run --env SCENARIO=concurrent_50 tests/load/load-booking.test.js",
    "test:load:booking:stress": "k6 run --env SCENARIO=stress tests/load/load-booking.test.js",
    "test:load:dashboard:baseline": "k6 run --env SCENARIO=baseline tests/load/load-dashboard.test.js",
    "test:load:dashboard:25": "k6 run --env SCENARIO=concurrent_25 tests/load/load-dashboard.test.js",
    "test:load:dashboard:50": "k6 run --env SCENARIO=concurrent_50 tests/load/load-dashboard.test.js",
    "test:load:dashboard:stress": "k6 run --env SCENARIO=stress tests/load/load-dashboard.test.js",
    "test:load:realtime:baseline": "k6 run --env SCENARIO=baseline tests/load/load-realtime.test.js",
    "test:load:realtime:20": "k6 run --env SCENARIO=concurrent_20 tests/load/load-realtime.test.js",
    "test:load:realtime:stress": "k6 run --env SCENARIO=stress tests/load/load-realtime.test.js",
    "test:load:redis:baseline": "k6 run --env SCENARIO=baseline tests/load/load-redis.test.js",
    "test:load:redis:100": "k6 run --env SCENARIO=concurrent_100 tests/load/load-redis.test.js",
    "test:load:redis:500": "k6 run --env SCENARIO=concurrent_500 tests/load/load-redis.test.js",
    "test:load:redis:stress": "k6 run --env SCENARIO=stress tests/load/load-redis.test.js",
    "test:load:all": "npm run test:load:setup && npm run test:load:booking:baseline && npm run test:load:booking:10 && npm run test:load:booking:stress && npm run test:load:dashboard:baseline && npm run test:load:dashboard:25 && npm run test:load:dashboard:stress && npm run test:load:realtime:baseline && npm run test:load:realtime:20 && npm run test:load:redis:baseline && npm run test:load:redis:100 && npm run test:load:cleanup",
    "test:load:ci": "npm run test:load:setup && npm run test:load:booking:10 && npm run test:load:dashboard:25 && npm run test:load:redis:100 && npm run test:load:cleanup",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.6.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
