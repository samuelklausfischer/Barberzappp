# ==============================================
# BarberZap Multi-Region Deployment Environment
# ==============================================
# Copy this file to .env and fill in your values

# ----------------------------------------------
# Application Settings
# ----------------------------------------------
APP_NAME=barberzap
ENVIRONMENT=production
BUILD_TAG=latest
REGION=latam

# ----------------------------------------------
# Supabase Configuration
# ----------------------------------------------
# Get from https://supabase.com/dashboard
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
SUPABASE_ORGANIZATION_ID=your_org_id

# LATAM (Primary)
SUPABASE_URL_LATAM=https://your-latam-project.supabase.co
SUPABASE_KEY_LATAM=your_latam_anon_key
SUPABASE_JWT_SECRET_LATAM=your_latam_jwt_secret

# US-East
SUPABASE_URL_USEAST=https://your-useast-project.supabase.co
SUPABASE_KEY_USEAST=your_useast_anon_key

# US-West
SUPABASE_URL_USWEST=https://your-uswest-project.supabase.co
SUPABASE_KEY_USWEST=your_uswest_anon_key

# Europe Central
SUPABASE_URL_EU=https://your-eu-project.supabase.co
SUPABASE_KEY_EU=your_eu_anon_key

# Asia Pacific
SUPABASE_URL_AP=https://your-ap-project.supabase.co
SUPABASE_KEY_AP=your_ap_anon_key

# Common key (for simplicity)
SUPABASE_KEY=your_primary_anon_key
SUPABASE_JWT_SECRET=your_primary_jwt_secret

# ----------------------------------------------
# Redis Configuration
# ----------------------------------------------
# LATAM (Primary)
REDIS_HOST_LATAM=redis-master-latam
REDIS_PORT_LATAM=6379
REDIS_PASSWORD_LATAM=

# US-West
REDIS_HOST_USWEST=redis-master-uswest
REDIS_PORT_USWEST=7379
REDIS_PASSWORD_USWEST=

# EU-Central
REDIS_HOST_EU=redis-master-eu
REDIS_PORT_EU=9379
REDIS_PASSWORD_EU=

# Asia-Pacific
REDIS_HOST_AP=redis-master-ap
REDIS_PORT_AP=10379
REDIS_PASSWORD_AP=

# Common
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_SSL=false
RETRY_ON_TIMEOUT=true

# Redis Sentinel (LATAM)
REDIS_SENTINEL_HOST=redis-sentinel-latam
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_MASTER=mymaster

# ----------------------------------------------
# Docker Registry
# ----------------------------------------------
DOCKER_REGISTRY=docker.io/your-username
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# Optional: ECR (AWS)
# AWS_ECR_REGISTRY=123456789.dkr.ecr.us-east-1.amazonaws.com
# AWS_ECR_REGION=us-east-1

# ----------------------------------------------
# AWS Configuration
# ----------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# ----------------------------------------------
# Cloudflare Configuration
# ----------------------------------------------
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_ACCOUNT_ID=your_account_id

# Cloudflared Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# ----------------------------------------------
# Regional API URLs
# ----------------------------------------------
# LATAM
UPSTREAM_LATAM=https://api-latam.barberzap.com
# US-East
UPSTREAM_USEAST=https://api.barberzap.com
# US-West
UPSTREAM_USWEST=https://api-uswest.barberzap.com
# Europe
UPSTREAM_EU=https://api-eu.barberzap.com
# Asia-Pacific
UPSTREAM_AP=https://api-ap.barberzap.com

# ----------------------------------------------
# Monitoring & Logging
# ----------------------------------------------
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_RETENTION=15d

# Grafana
GRAFANA_PASSWORD=admin
GRAFANA_ADMIN_USER=admin

# Loki
LOKI_ENABLED=true

# Sentry (Error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ----------------------------------------------
# Feature Flags
# ----------------------------------------------
ENABLE_REGION_ROUTING=true
ENABLE_CIRCUIT_BREAKER=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
ENABLE_AUTO_FAILOVER=true
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ----------------------------------------------
# Worker Configuration
# ----------------------------------------------
WORKER_CONCURRENCY=5
WORKER_QUEUE=barberzap
 BullMQ_REDIS_HOST=redis-master-latam

# ----------------------------------------------
# Database (for local development)
# ----------------------------------------------
# Use Supabase in production
DATABASE_TYPE=supabase
# For local dev with postgres:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=barberzap

# ----------------------------------------------
# API Configuration
# ----------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
WORKERS=4
LOG_LEVEL=INFO

# ----------------------------------------------
# Frontend Configuration
# ----------------------------------------------
# These values are used in Vite builds
VITE_APP_URL=https://barberzap.com
VITE_API_URL=https://api.barberzap.com
VITE_WS_URL=wss://ws.barberzap.com
VITE_REALTIME_URL=wss://realtime.supabase.co
VITE_ENABLE_REGION_DETECTION=true

# ----------------------------------------------
# Backup Configuration
# ----------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 3 * * *

# ----------------------------------------------
# Security
# ----------------------------------------------
# CORS
CORS_ORIGINS=https://barberzap.com,https://www.barberzap.com
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------
# Notification
# ----------------------------------------------
ERROR_NOTIFICATION_WEBHOOK=
ERROR_NOTIFICATION_EMAIL=

# ----------------------------------------------
# Analytics
# ----------------------------------------------
GOOGLE_ANALYTICS_ID=
POSTHOG_API_KEY=
POSTHOG_HOST=

# ----------------------------------------------
# Email (for notifications)
# ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@barberzap.com

# ----------------------------------------------
# Storage
# ----------------------------------------------
# Supabase Storage (default)
STORAGE_TYPE=supabase
# Or S3:
# AWS_S3_BUCKET=barberzap-uploads
# AWS_S3_REGION=us-east-1

